TEXT_R = 0.8;  TEXT_G = 0.8;  TEXT_B = 0.8;
BG_R = 0.157;  BG_G = 0.157;  BG_B = 0.157;

Window.SetBackgroundTopColor(BG_R, BG_G, BG_B);
Window.SetBackgroundBottomColor(BG_R, BG_G, BG_B);

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

bg_src = Image("background.png");
bg_scale = Math.Max(screen_w / bg_src.GetWidth(), screen_h / bg_src.GetHeight());
bg_w = Math.Int(bg_src.GetWidth() * bg_scale + 0.999);
bg_h = Math.Int(bg_src.GetHeight() * bg_scale + 0.999);
bg_off_x = Math.Max((screen_w - bg_w) / 2, 0.05 * screen_w - 285 * bg_scale);
bg_off_x = Math.Min(bg_off_x, 0);
bg_off_x = Math.Max(bg_off_x, screen_w - bg_w);
bg_off_y = 0;
bg_sprite = Sprite(bg_src.Scale(bg_w, bg_h));
bg_sprite.SetPosition(screen_x + Math.Int(bg_off_x), screen_y + bg_off_y, -100);

dot_src = Image("dot.png");
dot_size = Math.Max(6, Math.Int(screen_h * 0.014));
dot_gap  = Math.Int(dot_size * 1.4);
dot_img  = dot_src.Scale(dot_size, dot_size);
dots_total = 3 * dot_size + 2 * dot_gap;
dots_x = screen_x + Math.Int((screen_w - dots_total) / 2);
dots_y = screen_y + Math.Int(screen_h * 0.74);
for (i = 0; i < 3; i++) {
    dot[i] = Sprite(dot_img);
    dot[i].SetPosition(dots_x + i * (dot_size + dot_gap), dots_y, 10);
    dot[i].SetOpacity(0.3);
}

frame = 0;
fun refresh_callback() {
    global.frame++;
    for (i = 0; i < 3; i++) {
        phase = global.frame * 0.09 - i * 0.9;
        level = (Math.Sin(phase) + 1) / 2;
        dot[i].SetOpacity(0.25 + 0.75 * level * level);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

font_px = Math.Max(10, Math.Int(screen_h / 60));
FONT = "Sans " + font_px;

fun text_sprite(str, y, z) {
    img = Image.Text(str, TEXT_R, TEXT_G, TEXT_B, 1, FONT);
    spr = Sprite(img);
    spr.SetPosition(screen_x + Math.Int((screen_w - img.GetWidth()) / 2), y, z);
    return spr;
}

message_y = screen_y + Math.Int(screen_h * 0.82);
fun display_message_callback(text) {
    global.message_sprite = text_sprite(text, message_y, 20);
}
fun hide_message_callback(text) {
    global.message_sprite = NULL;
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

prompt_y = screen_y + Math.Int(screen_h * 0.60);
entry_y  = prompt_y + Math.Int(font_px * 2.8);

bullet_count = 0;
fun clear_prompt() {
    global.prompt_sprite = NULL;
    global.entry_sprite = NULL;
    for (i = 0; i < global.bullet_count; i++)
        global.bullet[i] = NULL;
    global.bullet_count = 0;
}

fun display_password_callback(prompt, bullets) {
    clear_prompt();
    if (!prompt) prompt = "Password";
    global.prompt_sprite = text_sprite(prompt, prompt_y, 30);
    n = Math.Min(bullets, 32);
    b_size = Math.Max(5, Math.Int(dot_size * 0.75));
    b_gap = Math.Int(b_size * 0.8);
    b_img = dot_src.Scale(b_size, b_size);
    row_w = n * b_size + (n - 1) * b_gap;
    for (i = 0; i < n; i++) {
        global.bullet[i] = Sprite(b_img);
        global.bullet[i].SetPosition(screen_x + Math.Int((screen_w - row_w) / 2) + i * (b_size + b_gap),
                                     entry_y + Math.Int(font_px / 2), 30);
    }
    global.bullet_count = n;
}

fun display_question_callback(prompt, entry) {
    clear_prompt();
    global.prompt_sprite = text_sprite(prompt, prompt_y, 30);
    global.entry_sprite = text_sprite(entry + "_", entry_y, 30);
}

fun display_normal_callback() {
    clear_prompt();
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
