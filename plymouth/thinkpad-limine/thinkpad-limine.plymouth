[Plymouth Theme]
Name=ThinkPad Limine
Description=Boot splash matching the ThinkPad Limine menu. Artwork from distro-grub-themes (grub-theme-thinkpad 3.4, GPL-3.0).
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/thinkpad-limine
ScriptFile=/usr/share/plymouth/themes/thinkpad-limine/thinkpad-limine.script
